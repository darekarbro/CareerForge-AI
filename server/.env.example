# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Generate a private secret for production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Development uses a local-only default when left blank.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated CLIENT_URL origins are allowed. Set TRUST_PROXY only to your deployment's trusted proxy hops/subnets.
TRUST_PROXY=
# Request limits per 15 minutes (AI quota per authenticated account plus an IP limit).
AUTH_RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=30

# Firebase Admin (Required for Google sign-in via Firebase)
# These stay on the backend only and must come from your Firebase service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Database (required in production; development uses a temporary MongoDB if blank/unavailable)
MONGODB_URI=

# AI Providers (Optional - will fall back to Deterministic Rule Engine if left blank)
# Primary provider: copy these settings to server/.env and replace the placeholder key.
# Model options: openai/gpt-oss-120b (default) or openai/gpt-oss-20b (lower latency).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Maximum duration for each AI-provider attempt; failed attempts fall back automatically.
AI_PROVIDER_TIMEOUT_MS=15000

# Cloudinary Storage (Optional - will use local uploads directory fallback if left blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Queue (Optional - will use in-memory background job queue fallback if left blank)
REDIS_URL=
