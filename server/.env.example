# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_SECRET=careerforge-super-secret-jwt-key-2026

# Database (Optional - will use in-memory mongodb-memory-server if left blank)
MONGODB_URI=

# AI Providers (Optional - will fall back to Deterministic Rule Engine if left blank)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cloudinary Storage (Optional - will use local uploads directory fallback if left blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Queue (Optional - will use in-memory background job queue fallback if left blank)
REDIS_URL=
