# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_SECRET=careerforge-super-secret-jwt-key-2026

# Firebase Admin (Required for Google sign-in via Firebase)
# These stay on the backend only and must come from your Firebase service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Database (Optional - will use in-memory mongodb-memory-server if left blank)
MONGODB_URI=

# AI Providers (Optional - will fall back to Deterministic Rule Engine if left blank)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Maximum duration for each AI-provider attempt; failed attempts fall back automatically.
AI_PROVIDER_TIMEOUT_MS=15000

# Cloudinary Storage (Optional - will use local uploads directory fallback if left blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Queue (Optional - will use in-memory background job queue fallback if left blank)
REDIS_URL=
