{
  "name": "careerforge-ai-workspace",
  "version": "1.0.0",
  "description": "CareerForge AI Career Readiness Platform Workspace",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "setup:local": "node scripts/setupLocal.cjs",
    "test:containers": "node scripts/testCompose.cjs",
    "check:deployment": "node scripts/checkDeployment.cjs",
    "build:server": "npm --prefix server install",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client start",
    "test": "npm --prefix server test && npm --prefix client test",
    "evaluate:phase4": "node server/scripts/evaluatePhase4.cjs",
    "evidence:phase6": "node server/scripts/phase6Evidence.cjs",
    "test:phase6:containers": "node scripts/testPhase6Containers.cjs",
    "lint": "npm --prefix client run lint",
    "build": "npm run build:client"
  }
}
